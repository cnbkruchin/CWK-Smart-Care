{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwk-smart-care.example.com/schema/portable/v1/attachment-index.schema.json",
  "title": "attachment-index.jsonl line",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "logical_id",
    "path",
    "size_bytes",
    "mime_type",
    "sha256",
    "classification",
    "links"
  ],
  "properties": {
    "logical_id": {
      "type": "string",
      "format": "uuid"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(\\/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
      "maxLength": 240
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "mime_type": {
      "type": "string",
      "maxLength": 100
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "classification": {
      "type": "string"
    },
    "original_filename": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_type",
          "entity_id"
        ],
        "properties": {
          "entity_type": {
            "type": "string"
          },
          "entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
