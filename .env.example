# Environment for Node components (gateway, reference REST API, migration CLI, tests)
# ค่าตัวอย่างเท่านั้น — ห้าม commit ไฟล์ .env จริง; ใน Cloud Run ใช้ Secret Manager

# ── PostgreSQL (reference backend / migration CLI) ──
# connection string อ่านจาก environment เท่านั้น ห้ามส่งเป็น argument ของคำสั่ง (shell history)
DATABASE_URL=postgres://cwk_app_login:change-me@127.0.0.1:5432/cwk            # app role
MIGRATION_DATABASE_URL=postgres://cwk_migrator_login:change-me@127.0.0.1:5432/cwk  # migration CLI role

# ── Reference REST API (future-platform/api, docs/REST_BACKEND_TH.md) ──
API_ENV=DEV                                    # DEV | STAGING | PROD
API_PORT=8080
API_HOST=0.0.0.0
API_AUTH_MODE=FIREBASE                         # FIREBASE (บังคับใน PROD) | DEMO (DEV/STAGING เท่านั้น — PROD ปฏิเสธ)
FIREBASE_PROJECT_ID=example-cwk-dev            # backend ตรวจ ID token เอง (Firebase Admin SDK + checkRevoked)
FIREBASE_TENANT_ID=                            # ว่าง = ไม่ใช้ multi-tenancy
FIREBASE_WEB_API_KEY=AIza-example-not-a-real-key   # public web config สำหรับหน้าเว็บ (จำกัด HTTP referrer ที่ Google Cloud)
FIREBASE_AUTH_DOMAIN=example-cwk-dev.firebaseapp.com
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json   # หรือ workload identity บน Cloud Run (ห้าม commit ไฟล์ key)
API_DEMO_PASSPHRASE=                           # [SECRET] DEV/STAGING + API_AUTH_MODE=DEMO เท่านั้น (≥ 8 ตัวอักษร)
API_ALLOWED_ORIGINS=http://localhost:5173      # CORS allowlist (คั่นด้วย ,); PROD ต้องเป็น https:// — หน้าเว็บที่ API เสิร์ฟเองไม่ต้องใส่
API_PUBLIC_URL=http://localhost:8080           # URL ที่ใช้สร้างลิงก์ในข้อความ (PROD: https://)
API_MAX_BODY_BYTES=12582912                    # ขนาด body สูงสุด (ไฟล์แนบเดินทางเป็น base64 ใน envelope)
API_WORKER=true                                # รันงานเบื้องหลัง (tick + jobs) ในโปรเซสนี้; หลาย instance ใช้ advisory lock ให้ทำทีละตัว
API_WORKER_INTERVAL_SECONDS=60
API_SERVE_WEB=true                             # เสิร์ฟเว็บรุ่นเริ่มต้น (future-platform/web) ที่ /
API_TIMEZONE=Asia/Bangkok
API_DB_POOL_MAX=10
STORAGE_DIR=./.local/storage                   # ไฟล์แนบ (private, mode 0600) — production ใช้ volume ที่สำรองข้อมูลได้
EXPORT_DIR=./.local/exports                    # portable packages จากศูนย์ย้ายข้อมูล
API_LINE_WEBHOOK_KEY_ID=                       # LINE webhook ผ่าน gateway (ยังไม่มี LINE provider บน Node — route ปิดอยู่)
API_LINE_WEBHOOK_SECRET=                       # [SECRET]

# ── REST admin CLI (future-platform/api/admin.mjs) ──
DATABASE_OWNER_URL=postgres://cwk_owner:change-me@127.0.0.1:5432/cwk   # [SECRET] init-db เท่านั้น (สร้าง schema/roles)
APP_LOGIN_PASSWORD=                            # [SECRET] รหัสผ่านของ login role ที่ init-db --app-login สร้าง (≥ 12 ตัวอักษร)

# ── Gateway (Cloud Run) ──
GATEWAY_PORT=8080
GATEWAY_GAS_EXEC_URL=https://script.google.com/macros/s/EXAMPLE_DEPLOYMENT_ID/exec
GATEWAY_GAS_KEY_ID=gas-dev-1
GATEWAY_GAS_SHARED_SECRET=example-base64-secret-32-bytes-min   # ตรงกับ CWK_GATEWAY_SECRET ใน Script Properties
GATEWAY_LINE_KEY_ID=line-dev-1
GATEWAY_LINE_ENVELOPE_SECRET=example-base64-secret-32-bytes-min # ตรงกับ CWK_LINE_WEBHOOK_SECRET
LINE_CHANNEL_SECRET=example-line-channel-secret
FIREBASE_PROJECT_ID_EXPECTED=example-cwk-dev
GATEWAY_MAX_BODY_BYTES=1048576
