# Environment for Node components (gateway, reference REST API, migration CLI, tests)
# ค่าตัวอย่างเท่านั้น — ห้าม commit ไฟล์ .env จริง; ใน Cloud Run ใช้ Secret Manager

# ── PostgreSQL (reference backend / migration CLI) ──
# connection string อ่านจาก environment เท่านั้น ห้ามส่งเป็น argument ของคำสั่ง (shell history)
DATABASE_URL=postgres://cwk_app_login:change-me@127.0.0.1:5432/cwk            # app role
MIGRATION_DATABASE_URL=postgres://cwk_migrator_login:change-me@127.0.0.1:5432/cwk  # migration CLI role

# ── Reference REST API ──
API_PORT=8080
API_AUTH_MODE=FIREBASE                         # FIREBASE | DEV_HMAC (DEV/test เท่านั้น)
API_ENV=DEV                                    # DEV | STAGING | PROD (PROD ปฏิเสธ DEV_HMAC)
FIREBASE_PROJECT_ID=example-cwk-dev
API_DEV_HMAC_SECRET=dev-only-not-secret
API_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_DIR=./.local/storage                   # filesystem AttachmentStorage สำหรับทดสอบ

# ── Gateway (Cloud Run) ──
GATEWAY_PORT=8080
GATEWAY_GAS_EXEC_URL=https://script.google.com/macros/s/EXAMPLE_DEPLOYMENT_ID/exec
GATEWAY_GAS_KEY_ID=gas-dev-1
GATEWAY_GAS_SHARED_SECRET=example-base64-secret-32-bytes-min   # ตรงกับ CWK_GATEWAY_SECRET ใน Script Properties
GATEWAY_LINE_KEY_ID=line-dev-1
GATEWAY_LINE_ENVELOPE_SECRET=example-base64-secret-32-bytes-min # ตรงกับ CWK_LINE_WEBHOOK_SECRET
LINE_CHANNEL_SECRET=example-line-channel-secret
FIREBASE_PROJECT_ID_EXPECTED=example-cwk-dev
GATEWAY_MAX_BODY_BYTES=1048576
