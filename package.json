{
  "name": "cwk-smart-care",
  "version": "0.7.0",
  "private": true,
  "description": "CWK Smart Care — ระบบแจ้งลา ลงเวลาสาย ติดตามการมาเรียน และดูแลช่วยเหลือนักเรียน โรงเรียนจุนวิทยาคม",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "build": "node tools/build-gas.mjs",
    "gen": "node tools/gen-docs.mjs",
    "check:gen": "node tools/gen-docs.mjs --check",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:domain": "node --test \"tests/domain/*.test.mjs\"",
    "test:app": "node --test \"tests/application/*.test.mjs\"",
    "test:gas": "npm run build && node --test \"tests/gas/*.test.mjs\"",
    "test:pg": "npm run build && node tools/pg-local.mjs run -- node --test --test-concurrency=1 \"tests/migration/*.test.mjs\" \"tests/contract/*.test.mjs\" \"tests/api/*.test.mjs\"",
    "test:web": "node tools/pg-local.mjs run -- node tests/ui/web-starter-smoke.mjs",
    "capacity": "node tools/capacity.mjs",
    "fixtures": "node tools/fixtures/generate-synthetic.mjs",
    "migrate": "node tools/migrate.mjs",
    "api": "node future-platform/api/server.mjs",
    "api:admin": "node future-platform/api/admin.mjs",
    "test:ui": "node tests/ui/ui-smoke.mjs",
    "rehearse:pg": "node tools/rehearse-postgres.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
